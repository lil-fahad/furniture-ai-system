{
  "version": 1,
  "sync": {
    "enabled": true,
    "remote": "origin",
    "branch": "main",
    "interval_seconds": 300
  },
  "idle_sleep_seconds": 30,
  "shutdown_grace_seconds": 45,
  "jobs": [
    {
      "id": "style-classifier-v2-convnext",
      "task": "style_classifier",
      "enabled": true,
      "data": "data/styles_prepared",
      "output": "models/style_classifier/convnext_base_v2.pth",
      "checkpoint_every_steps": 100,
      "args": [
        "--model-name",
        "hf_hub:timm/convnext_base.fb_in22k_ft_in1k",
        "--epochs",
        "30",
        "--batch-size",
        "16",
        "--gradient-accumulation-steps",
        "2",
        "--learning-rate",
        "0.00005",
        "--device",
        "cuda",
        "--precision",
        "auto",
        "--class-balance",
        "sampler",
        "--early-stopping-patience",
        "6"
      ]
    },
    {
      "id": "room-classifier-v2-convnext",
      "task": "room_classifier",
      "enabled": true,
      "data": "data/rooms",
      "output": "models/room_classifier/convnext_base_v2.pth",
      "checkpoint_every_steps": 100,
      "args": [
        "--model-name",
        "hf_hub:timm/convnext_base.fb_in22k_ft_in1k",
        "--epochs",
        "20",
        "--batch-size",
        "16",
        "--gradient-accumulation-steps",
        "2",
        "--learning-rate",
        "0.00005",
        "--device",
        "cuda",
        "--precision",
        "auto",
        "--class-balance",
        "sampler",
        "--early-stopping-patience",
        "6"
      ]
    },
    {
      "id": "floorplan-segmenter",
      "task": "floorplan_segmenter",
      "enabled": true,
      "data": "data/plans",
      "output": "models/floorplan_segmenter/unet.pt",
      "args": [
        "--epochs",
        "30",
        "--batch-size",
        "4",
        "--device",
        "cuda",
        "--mask-remap",
        "auto",
        "--early-stopping-patience",
        "6"
      ]
    }
  ]
}
