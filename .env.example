# Runtime mode: development, test, or production.
# production requires SERVICE_API_KEY with at least 24 characters.
ENVIRONMENT=development
# API key protecting /api/v1/* endpoints when set. Min 24 chars in production.
SERVICE_API_KEY=
# Optional OpenAI integration (leave empty to disable).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# SQLite booking database path. Relative paths are anchored at the project
# root (dev checkout) or, if absent there, the current working directory.
DATABASE_PATH=data/furniture_ai.sqlite3
# Furniture catalog consumed by /api/v1/catalog and the layout engine.
# Same anchoring rules as DATABASE_PATH.
CATALOG_PATH=data/furniture_catalog.json
# Upload limits: bytes (1024..104857600) and decoded pixel count (1e6..1e8).
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
# Comma-separated CORS origins; wildcards are rejected.
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Model registry consumed by /api/v1/models and /ready.
MODEL_MANIFEST_PATH=models/manifest.json
# Verified local professional Hugging Face bundles used by /api/v1/scene.
PROFESSIONAL_MODELS_ROOT=models/professional/installed/pretrained
# NVIDIA runtime controls. auto selects CUDA when available and otherwise CPU.
# On CUDA, auto precision prefers BF16 when supported and otherwise FP16.
PROFESSIONAL_VISION_DEVICE=auto
PROFESSIONAL_VISION_PRECISION=auto
# Keep compile disabled until benchmarked on the exact deployment GPU/driver.
PROFESSIONAL_VISION_TORCH_COMPILE=false
# The Dockerfile pins absolute paths for the wheel-installed image:
# MODEL_MANIFEST_PATH=/app/models/manifest.json,
# CATALOG_PATH=/app/data/furniture_catalog.json,
# DATABASE_PATH=/data/furniture_ai.sqlite3 (writable app-owned volume dir).
# Base URL of the FastAPI service, consumed by the Streamlit UI
# (apps/streamlit_app.py). Not a server-side setting.
FURNITURE_API_URL=http://127.0.0.1:8000
